  grammarQuestions:
  - image: {fileID: 21300000, guid: f4b238deb04379440aa586d4ac6b4d83, type: 3}
    sentenceWithBlank: The clue ___ he found was very important.
    completedSentence: The clue that he found was very important.
    options:
    - which
    - where
    - is
    - that
    correctAnswer: that
  - image: {fileID: 21300000, guid: ad0745427619e1d478803b8a243c36bc, type: 3}
    sentenceWithBlank: She looked ___ her bag under the table.
    completedSentence: She looked for her bag under the table.
    options:
    - to
    - for
    - where
    - are
    correctAnswer: for
  - image: {fileID: 21300000, guid: 82a44bbe363c67044b1fe21d63270886, type: 3}
    sentenceWithBlank: Not only the lady but also the children ___ confused.
    completedSentence: Not only the lady but also the children are confused.
    options:
    - will have been
    - were
    - has
    - are
    correctAnswer: are
  - image: {fileID: 21300000, guid: 9fb25b1c5a99bb142a2074a3f7cf2808, type: 3}
    sentenceWithBlank: One of the boys ___ climbed the tree.
    completedSentence: One of the boys has climbed the tree.
    options:
    - has been
    - has
    - had been
    - had
    correctAnswer: has
  - image: {fileID: 21300000, guid: e5c9b4777d55eda4bb7c4786b8d8843a, type: 3}
    sentenceWithBlank: A group of children ___ playing.
    completedSentence: A group of children is playing.
    options:
    - was
    - had been
    - is
    - are
    correctAnswer: is
  - image: {fileID: 21300000, guid: 7521da165d8f72740a845aaed2fe6f16, type: 3}
    sentenceWithBlank: The children ___ taken to the museum yesterday.
    completedSentence: The children were taken to the museum yesterday.
    options:
    - was
    - has been
    - has
    - were
    correctAnswer: were
  - image: {fileID: 21300000, guid: 254459f829455dd49874b310574a995d, type: 3}
    sentenceWithBlank: "Had he ___ the mistake, he wouldn\u2019t have repeated it."
    completedSentence: "Had he noticed the mistake, he wouldn\u2019t have repeated
      it."
    options:
    - notice
    - has been noticed
    - been notice
    - noticed
    correctAnswer: noticed
  - image: {fileID: 21300000, guid: 4d2ab5d4db3ea5a46b467cbcb45c983e, type: 3}
    sentenceWithBlank: Neither of the people ___ ready to leave.
    completedSentence: Neither of the people is ready to leave.
    options:
    - had
    - is
    - has been
    - will be
    correctAnswer: is
  - image: {fileID: 21300000, guid: 3fd7f9b75064c8b4b901d355603c2ad0, type: 3}
    sentenceWithBlank: "I don\u2019t know ___ he will reply to my letter."
    completedSentence: "I don\u2019t know whether he will reply to my letter."
    options:
    - if
    - as
    - have
    - whether
    correctAnswer: whether
  - image: {fileID: 21300000, guid: 3f14815500d814b4295c023b2b560184, type: 3}
    sentenceWithBlank: The car went slowly ___ the bumpy road.
    completedSentence: The car went slowly through the bumpy road.
    options:
    - from
    - with
    - through
    - where
    correctAnswer: through
